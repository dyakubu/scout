# Go build artifacts
/scout
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
*.db*
.DS_Store

# Native deps (onnxruntime, tokenizers) fetched locally, not committed.
/third_party/

# Packaged release archives (scripts/package-release.sh output).
/dist/

# Python (media worker) build/runtime artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The CLIP model media.model_dir points at. Not committed - it ships in
# the release archive, assembled at packaging time, the same way the text
# embedder's ONNX model is committed but onnxruntime isn't. /media/model
# and media_embedding are older locations for it, ignored so a stale copy
# left over from before the default changed can't get committed.
/models/media/
/media/model/
media_embedding/